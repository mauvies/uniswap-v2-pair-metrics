# Copy to .env. Required — https://thegraph.com/studio/apikeys/
THEGRAPH_API_KEY=

# Optional. The API binds here; HOST=0.0.0.0 to accept connections from off the machine.
# PORT=3000
# HOST=127.0.0.1

# Optional. docker-compose.yaml defaults to these; override POSTGRES_PORT if 5432 is taken.
# POSTGRES_USER=uniswap
# POSTGRES_PASSWORD=uniswap
# POSTGRES_DB=uniswap_v2_pair_metrics
# POSTGRES_PORT=5432
