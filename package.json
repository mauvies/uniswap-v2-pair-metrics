{
  "name": "uniswap-v2-pair-metrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @uniswap-v2-pair-metrics/shared db:generate",
    "db:migrate": "pnpm db:up && pnpm --filter @uniswap-v2-pair-metrics/shared db:migrate",
    "db:reset": "docker compose down -v && pnpm db:migrate",
    "ingest": "pnpm --filter @uniswap-v2-pair-metrics/ingest start",
    "test": "pnpm -r --if-present test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "typescript": "^6.0.3"
  }
}
