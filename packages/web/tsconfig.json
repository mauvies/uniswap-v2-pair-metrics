{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles this package (§3), so resolution is the bundler's rather than Node's.
    // `moduleResolution: bundler` is only legal alongside a `module` of `preserve` or
    // `es2015`+, so the base's `NodeNext` has to go with it — the two are cross-validated.
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // `vite/client` is what declares `*.css` as a module, without which every stylesheet
    // import here is an unresolved-module error.
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
