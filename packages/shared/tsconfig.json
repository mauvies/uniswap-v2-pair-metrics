{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Consumed as source, never built (§3). No emit means imports can carry the real
    // `.ts` extension instead of a `.js` one that never exists on disk.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "drizzle.config.ts"]
}
